<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vannon</groupId>        <artifactId>syx-economy-mod</artifactId>
        <version>0.13.107</version>

    <properties>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.source>21</maven.compiler.source>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mod.name>SyxEconomyMod</mod.name>
        <mod.version>${project.version}</mod.version>
        <mod.author>Vannon</mod.author>
        <mod.description>Vollwertige Wirtschaftssimulation für Songs of Syx V71: Arbeitsmarkt, Firmen-Profitmaximierung, Marktpreise, Geldumlauf, Steuern, Staatskasse, Vermögensverteilung und Krisenmechanik.</mod.description>
        <!-- Sprint v0.13.127+Stam-Doc-Global-Sync: mod.info global an project.version binden.
             Vorher war der Wert hardcoded v0.13.31-alpha → driftete auf 0.13.101 = in-game Info-Feld
             zeigte v0.13.31-alpha während VERSION 0.13.101. Jetzt v${project.version}: die
             `${project.version}`-Substitution wird bei mvn package durchgeführt (Resource-Filtering),
             ${mod.info} in _Info.txt zeigt IMMER die aktuelle projekt-version. Detail-Description
             (Phase A-F Bypass-SDK ...) bleibt in <mod.description> bzw. CHANGELOG.md.
             Rule 3.1 Sub-Rule: globale Sync-Invariant zwischen pom <version>, <mod.version> und <mod.info>. -->
        <mod.info>SyxEconomyMod v${project.version}</mod.info>
        <mod.homepage>https://github.com/vannon/syx-economy-mod</mod.homepage>
        <mod.license>MIT</mod.license>
        <mod.credits>Original mod by Vannon; localization and optimizations by the SyxEconomyMod team.</mod.credits>
        <mod.dependencies>Requires Songs of Syx V71.44 or compatible. No other mods required.</mod.dependencies>
        <mod.changelog>v0.13.107 - Phase A-F: BypassGate SDK (FieldAccessor/MethodAccessor/ClassResolver), 5 Adapter auf BypassGate migriert, 7 Dateien gelöscht (4 Fallback + 3 MH), EconConfig.useMethodHandleAdapters entfernt, BuildStamp-Identität, Adapter-READY-Logs; v0.13.1 - UX-Cleanup: Tooltip-Echo entfernt, Fenster-Stack-Offset+Defensiv-Audit, Deutsche Labels 140px+, Unicode→→Fix, Debug-Tab versteckt, close()-Reihenfolge fix, Farbige Balken (coloredBar) statt ASCII-Rauten, EconHud C.WIDTH()-Pos, LiveSlider-IntSupplier; v0.13.0 - Vanilla-Nativity: SPanel-Hintergrund, GCOLOR-Theme, Vanilla-Icons+Checkbox, Slider, EconHud; v0.1.3 - UX-Audit: 15 interaktive Tabs, Debug-Tab (Logger opt-in/out), SubjectJob Overlay, Block-Char-Balken fuer Ampeln, Not-Liquidation+Lohn-Slider+Steuer-Toggle, 'Was soll ich heute tun?'-Berater, Trend-Pfeile, IdentityMapRegistry LOG-Fix, TopBar entfernt, alle Toggles interaktiv; v0.1.2 - Hotfix: Phantom-Profit, globales Rate-Limiting, insolvenzsichere Surplus-Share; v0.1.1 - Balance-Krisen-Fixes: Firma-Cold-Start, Gewinnverteilung, Kopfsteuer-Armutsfreigrenze; v0.1.0 (Phase 4) - Adapter-Architektur: 5 Vanilla/Fallback-Interfaces, DiagnosticExporter, Rebalancing-Dashboard; v0.0.9 - Bauarbeiter swarming-Schutz, Starvation EventLog, O(1) ServiceCache; v0.0.8 - Audit-Fixes, Advisor Meilensteine; v0.0.7 - PovertyPressure, OddjobAutomation, WarehouseAutomation; v0.0.6 - Gini→Loyalty, Stufen-Freischaltung; v0.0.5 - Property-Markt; v0.0.4 - Scarcity→Price→Priority; v0.0.3 - roundingDrift-Fix, Housing-Miete; v0.0.2 - Chunked save/load; v0.0.1 - Berater-Tab, Erstveröffentlichung | CHANGELOG.md enthaelt die vollstaendige Historie.</mod.changelog>
        <mod.version.history>v0.13.108-docu-slim;v0.13.107-docu-baseline;pre-m1-reset-2026-07-28</mod.version.history>
        <game.version.major>71</game.version.major>
        <game.version.minor>44</game.version.minor>

        <game.install.directory>/home/vannon/snap/steam/common/.local/share/Steam/steamapps/common/Songs of Syx</game.install.directory>
        <game.mod.directory>${user.home}/.local/share/songsofsyx/mods</game.mod.directory>

        <mod.build.output.directory>${basedir}/target/out/${mod.name}</mod.build.output.directory>
        <mod.install.directory>${game.mod.directory}/${mod.name}</mod.install.directory>

        <!--
          Maven-Gate-Toggles:
            -Dgate.skip=true   -> ueberspringt den ganzen pre-compile Build-Gate
            -Dskip.bump=true   -> ueberspringt den post-install Patch-Bump (0.0.1+)
            -Djacoco.check.skip=true -> ueberspringt den JaCoCo-LINE/BRANCH-Check
                                        (T-COV-6, Sprint "Coverage-Kernel-Pass")
        -->
        <skip.bump>false</skip.bump>

        <!-- T-COV-6 JaCoCo-Coverage-Gate — Sprint "Coverage-Kernel-Pass".
             Default thresholds sind 0.0 / 0.0 = report-only (Check-Laeuft, bricht
             nichts). Sprint 5 misst die reale Coverage mit den 7 neuen Test-Suiten
             (target: line>=10%, branch>=5%) und zieht die Schwellen auf realistische
             Werte an. Sprint 9 (T-COV-9, Mockito-Inject) hebt sie auf line>=70% /
             branch>=60%. Property-Override per:
             mvn verify install -Djacoco.line.minimum=0.10 -Djacoco.branch.minimum=0.05 -->
        <jacoco.check.skip>false</jacoco.check.skip>
        <jacoco.line.minimum>0.0</jacoco.line.minimum>
        <jacoco.branch.minimum>0.0</jacoco.branch.minimum>

        <!-- Sprint 6.5 — Profile: 'dev' mit Vanilla-JAR auf Klassenpfad,
             'release' ohne (default, shaded jar ohne Vanilla-Code).
             Aktivierung: mvn verify install -Pdev.
             Default-Profil ist release — bleibt binary-compatibel mit V71.44. -->
        <dev.profile>false</dev.profile>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.songsofsyx</groupId>
            <artifactId>songsofsyx</artifactId>
            <version>${game.version.major}.${game.version.minor}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
        <!-- Sprint 6.0 — Mockito fuer engine-coupled Branches (Sprint 9 T-COV-9).
             Seit Mockito 5.0 ist mockito-inline in mockito-core integriert — kein
             separates Artifact noetig. mockito-junit-jupiter fuer @ExtendWith + @Mock.
             Sprint v0.13.106+Doku-Restruktur: Upgrade 5.14.2 -> 5.17.0 — Java-25-
             Classfile-Instrumentierung fuer finale Klassen (KpiSectionTest @Mock
             FlowPrices) funktionierte mit 5.14.2 nicht mehr ("Could not modify all
             classes"). mockito-core 5.17.0 zieht transitiv weiterhin byte-buddy
             1.15.11 → deshalb zusaetzlich der explizite ByteBuddy-Pin unten. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.17.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.17.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Sprint v0.13.106+Doku-Restruktur: ByteBuddy-Pin auf 1.18.3 (Java-25-tauglich).
             mockito-core 5.17.0 deklariert transitiv weiterhin byte-buddy 1.15.11, das
             Java 25 (Classfile 69) offiziell nur bis 24 (68) unterstuetzt → Inline-Mockmaker
             scheitert beim Mocken finaler Klassen (KpiSectionTest @Mock FlowPrices) mit
             "Java 25 (69) is not supported by the current version of Byte Buddy".
             Expliziter Pin ueberschreibt die transitive Version. -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.18.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>1.18.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${mod.name}</finalName>
        <!-- Use 'src' as the root source directory for compilation -->
        <sourceDirectory>src</sourceDirectory>
        <!-- Tests live outside src/ so they don't get compiled as main sources -->
        <testSourceDirectory>test/java</testSourceDirectory>

        <!-- No classpath resources needed; assets are copied explicitly via maven-resources-plugin -->
        <resources/>

        <plugins>
            <!-- Compiler: Strict Mode — Warnings als Fehler, alle Lints aktiv.
                 Nur unsere Sources (src/vannon/) werden geprüft, nicht Vanilla-Dependencies. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <!-- TODO: -Werror reaktivieren sobald alle redundant-cast/rawtypes/unchecked
                             Warnings aus Vanilla-API-Interaktionen bereinigt sind (ca. 105 Stellen).
                             Phase: tools/lint-cleanup.sh erstellt eine Baseline, dann Datei für Datei
                             @SuppressWarnings oder echte Typ-Fixes anwenden. -->
                        <arg>-Xlint:all,-options</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>
            <!-- Pre-build gates: Stam-Doku-Sync + Code-Audit + Version-Consistency + Adapter-Signaturen.
                 Fehlschlag = Build-Abbruch. Überspringbar mit -Dgate.skip=true -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- ─── BuildStamp: unique per-compile identity anchor ────────────
                         Generates BuildStamp.java with git hash, timestamp, dirty flag.
                         Runs BEFORE compile so every build gets a fresh identity.
                         Visible in-game via EconHud + window titles.
                         
                         Skip with -Dskip.buildstamp=true (emergency only). -->
                    <execution>
                        <id>generate-build-stamp</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.buildstamp}</skip>
                            <target>
                                <exec executable="bash" failonerror="false" dir="${basedir}">
                                    <arg value="tools/generate-build-stamp.sh"/>
                                    <arg value="${basedir}/src/vannon/syx/economy/core"/>
                                    <arg value="${project.version}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>

                    <!--
                      Sprint v0.13.108+Doku-Slim GATE-12: Unified Pre-Build Gate.

                      Single antrun-execution fasst die 3 ehemaligen validations-
                      (preflight-stam-doc-sync + preflight-god-class-guard + build-gate)
                      zu EINEM bash-Invok zusammen. gate.sh prebuild delegiert intern
                      an build-gate.sh (alle 9 Gates); doku-sync.sh ist jetzt Gate 1 in
                      build-gate.sh (war frueher standalone Preflight via verify-doc-sync.sh).
                      Reduziert 3 Maven-Validate-Runs auf 1 und eliminiert den
                      POM_PREFLIGHT_DONE Sub-Shell-Hack. SKIP_* env-vars sind in
                      build-gate.sh vollstaendig entfernt — einzige Skip-Variante ist
                      -Dgate.skip=true (Maven) bzw. GATE_SKIP=true / gate.skip=true (env).
                    -->
                    <execution>
                        <id>preflight-unified-gate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${gate.skip}</skip>
                            <target>
                                <exec executable="bash" failonerror="true" dir="${basedir}">
                                    <arg value="tools/gate.sh"/>
                                    <arg value="prebuild"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>

                    <!-- Sprint v0.13.108+Doku-Slim: Auto-Patch-Bump entfernt.
                         Bumps erfolgen jetzt explizit via 'bash tools/bump-version.sh patch -m "msg"',
                         das intern doku-sync.sh fix aufruft und atomar pom+Anker+CHANGELOG+Tag committet.
                         Verhindert Self-Referential-Gate-Kaskade (snapshot-stam-version.sh obsolet). -->
                </executions>
            </plugin>
            <!-- Install the game jar to local maven repo automatically so it will compile -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>install-game-jar</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <groupId>com.songsofsyx</groupId>
                            <artifactId>songsofsyx</artifactId>
                            <version>${game.version.major}.${game.version.minor}</version>
                            <packaging>jar</packaging>
                            <file>${game.install.directory}/SongsOfSyx.jar</file>
                            <generatePom>true</generatePom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Package a fat jar excluding com.songsofsyx -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>com.songsofsyx:*</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Sources jar: run 'mvn source:jar' on demand (not part of default build). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <skipSource>true</skipSource>
                </configuration>
            </plugin>

            <!-- Run JUnit 5 tests during test phase -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>

            <!-- JaCoCo coverage report for the kernel test suite.
                 T-COV-6 (Sprint "Coverage-Kernel-Pass"): prepare-agent + report laufen
                 wie bisher. NEU: jacoco-check goal in der verify-Phase prueft
                 LINE/BRANCH-Coverage gegen ${jacoco.line.minimum} und
                 ${jacoco.branch.minimum}. Default 0.0 = report-only (kein Break).
                 Sprint 9 setzt die Schwellen auf line>=70%/branch>=60% (T-COV-9,
                 Mockito-Inject fuer engine-coupled Branches). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <!-- T-COV-6 (Sprint 4): Coverage-Threshold wird auf das
                                     Production-Package begrenzt — test/-Code und
                                     adapter/-Reflection-Boilerplate zaehlen NICHT
                                     in den Threshold. Sprint 9 zieht die Schwellen
                                     auf line>=70%/branch>=60% an. -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <includes>
                                        <include>vannon.syx.economy.core.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Resource copying and installation -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <executions>

                    <!-- Copy src/assets into target/out/<ModName>/V71/assets -->
                    <execution>
                        <id>copy-assets</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.build.output.directory}/V${game.version.major}/assets</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/assets</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!-- Copy the built jar to target/out/<ModName>/V71/script -->
                    <execution>
                        <id>copy-script-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.build.output.directory}/V${game.version.major}/script</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${mod.name}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!-- Copy the sources jar to target/out/<ModName>/V71/script/_src -->
                    <execution>
                        <id>copy-sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.build.output.directory}/V${game.version.major}/script/_src</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${mod.name}-sources.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!-- Copy _Info.txt to target/out/<ModName> -->
                    <execution>
                        <id>copy-info-txt</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.build.output.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}</directory>
                                    <includes>
                                        <include>_Info.txt</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!-- Deploy built mod to the game's mod directory on mvn install -->
                    <execution>
                        <id>install-to-game</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.install.directory}</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${mod.build.output.directory}</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>